# Copy to .env and fill in. Never commit .env.
# Generate secrets with: python -c "import secrets; print(secrets.token_urlsafe(48))"

POSTGRES_USER=figure
# required (docker compose refuses to start without it)
POSTGRES_PASSWORD=
POSTGRES_DB=figure_archive
DATABASE_URL=postgresql+psycopg://figure:CHANGE_ME@127.0.0.1:5432/figure_archive

# required for admin APIs; at least 24 random characters
ADMIN_TOKEN=
# true when served over HTTPS
AUTH_COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# Local translation/classification (Ollama)
SEMANTIC_PROVIDER=ollama
SEMANTIC_BASE_URL=http://host.docker.internal:11434
SEMANTIC_TRANSLATION_MODEL=qwen3:8b
SEMANTIC_CLASSIFICATION_MODEL=qwen3:1.7b
SEMANTIC_REPORT_DIR=./data/private/semantics/split_queue_20261117

# Search / RAG
EMBEDDING_PROVIDER=hash
EMBEDDING_MODEL=
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
CHROMA_HOST=chroma
CHROMA_PORT=8000
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
SEARCH_API_KEY=

# Prices / collection
PRICE_MAX_AGE_HOURS=168
PRICE_CACHE_MINUTES=60
COLLECTION_DELAY_SECONDS=2

# Instagram (Meta Graph API)
META_APP_ID=
META_APP_SECRET=
META_ACCESS_TOKEN=
META_IG_USER_ID=
META_GRAPH_API_VERSION=v27.0
INSTAGRAM_COLLECTION_ENABLED=false
INSTAGRAM_DRY_RUN=true
