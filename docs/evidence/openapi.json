  "components": {
    "schemas": {
      "ChatRequest": {
        "properties": {
          "figure_id": {
            "type": "integer",
            "exclusiveMinimum": 0.0,
            "title": "Figure Id"
          },
          "variant_id": {
            "anyOf": [
              {
                "type": "integer",
                "exclusiveMinimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Variant Id"
          },
          "question": {
            "type": "string",
            "maxLength": 2000,
            "minLength": 1,
            "title": "Question"
          },
          "top_k": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 15.0,
                "minimum": 1.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Top K"
          },
          "mode": {
            "type": "string",
            "enum": [
              "similarity",
              "mmr"
            ],
            "title": "Mode",
            "default": "similarity"
          },
          "history": {
            "items": {
              "additionalProperties": {
                "type": "string"
              },
              "type": "object"
            },
            "type": "array",
            "maxItems": 12,
            "title": "History"
          }
        },
        "type": "object",
        "required": [
          "figure_id",
          "question"
        ],
        "title": "ChatRequest"
      },
      "CompareRequest": {
        "properties": {
          "figure_ids": {
            "items": {
              "type": "integer"
            },
            "type": "array",
            "maxItems": 4,
            "minItems": 2,
            "title": "Figure Ids"
          }
        },
        "type": "object",
        "required": [
          "figure_ids"
        ],
        "title": "CompareRequest"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "KoreaPreview": {
        "properties": {
          "source_url": {
            "type": "string",
            "maxLength": 1000,
            "title": "Source Url"
          }
        },
        "type": "object",
        "required": [
          "source_url"
        ],
        "title": "KoreaPreview"
      },
      "KoreaPriceInput": {
        "properties": {
          "variant_id": {
            "type": "integer",
            "exclusiveMinimum": 0.0,
            "title": "Variant Id"
          },
          "source_url": {
            "type": "string",
            "maxLength": 1000,
            "title": "Source Url"
          },
          "amount": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 999999999.0,
                "exclusiveMinimum": 0.0
              },
              {
                "type": "string"
              }
            ],
            "title": "Amount"
          },
          "price_kind": {
            "type": "string",
            "enum": [
              "korea_official_sale",
              "korea_official_list"
            ],
            "title": "Price Kind",
            "default": "korea_official_sale"
          },
          "confirmed_same_product": {
            "type": "boolean",
            "title": "Confirmed Same Product",
            "default": false
          }
        },
        "type": "object",
        "required": [
          "variant_id",
          "source_url",
          "amount"
        ],
        "title": "KoreaPriceInput"
      },
      "NameInput": {
        "properties": {
          "name_ko": {
            "type": "string",
            "maxLength": 500,
            "minLength": 1,
            "title": "Name Ko"
          }
        },
        "type": "object",
        "required": [
          "name_ko"
        ],
        "title": "NameInput"
      },
      "NaturalRequest": {
        "properties": {
          "query": {
            "type": "string",
            "maxLength": 500,
            "minLength": 1,
            "title": "Query"
          }
        },
        "type": "object",
        "required": [
          "query"
        ],
        "title": "NaturalRequest"
      },
      "PurchaseInput": {
        "properties": {
          "variant_id": {
            "type": "integer",
            "exclusiveMinimum": 0.0,
            "title": "Variant Id"
          },
          "amount": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 999999999999.0,
                "minimum": 0.0
              },
              {
                "type": "string"
              }
            ],
            "title": "Amount"
          },
          "currency": {
            "type": "string",
            "enum": [
              "KRW",
              "JPY",
              "USD"
            ],
            "title": "Currency",
            "default": "KRW"
          },
          "purchased_on": {
            "type": "string",
            "format": "date",
            "title": "Purchased On"
          },
          "delivery_status": {
            "type": "string",
            "enum": [
              "pending",
              "shipping",
              "delivered"
            ],
            "title": "Delivery Status",
            "default": "pending"
          },
          "shop": {
            "type": "string",
            "maxLength": 200,
            "title": "Shop",
            "default": ""
          },
          "memo": {
            "type": "string",
            "maxLength": 2000,
            "title": "Memo",
            "default": ""
          }
        },
        "type": "object",
        "required": [
          "variant_id",
          "amount",
          "purchased_on"
        ],
        "title": "PurchaseInput"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}